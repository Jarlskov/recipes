{% extends 'base.html.twig' %}

{% block title %}Check Your Email{% endblock %}

{% block body %}
<div class="max-w-md mx-auto">
    <div class="text-center mb-8">
        <h1 class="text-3xl font-bold mb-4">Check Your Email</h1>
        <p class="text-gray-600">We sent a password reset link to your email address.</p>
    </div>
    
    <div class="card">
        <div class="card-body text-center">
            <div class="mb-6">
                <div class="text-6xl mb-4">📧</div>
                <p class="text-gray-600 mb-4">
                    An email has been sent that contains a link you can click to reset your password.
                    This link will expire in {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
                </p>
            </div>

            <div class="flex flex-col gap-3">
                <p class="text-sm text-gray-500">
                    Didn't receive the email? Check your spam folder or 
                    <a href="{{ path('app_forgot_password_request') }}" class="text-primary-color hover:underline">try again</a>.
                </p>
                <div class="text-center">
                    <a href="{{ path('login') }}" class="text-primary-color hover:underline">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
