{% extends 'base.html.twig' %}

{% block title %}Recipe Manager{% endblock %}

{% block body %}
<div class="text-center mb-8">
    <h1 class="text-3xl font-bold mb-4">Recipe Manager</h1>
    <p class="text-lg text-gray-600">Organize your recipes, track cooking sessions, and manage your culinary creations.</p>
</div>

<div class="grid grid-2">
    <div class="card">
        <div class="card-body text-center">
            <h2 class="text-xl font-semibold mb-4">Get Started</h2>
            <p class="text-gray-600 mb-6">Create an account to start organizing your recipes and dishes.</p>
            <a href="{{ path('register') }}" class="btn btn-primary">Sign Up</a>
        </div>
    </div>
    
    <div class="card">
        <div class="card-body text-center">
            <h2 class="text-xl font-semibold mb-4">Already Have an Account?</h2>
            <p class="text-gray-600 mb-6">Sign in to access your recipes and cooking sessions.</p>
            <a href="{{ path('login') }}" class="btn btn-secondary">Sign In</a>
        </div>
    </div>
</div>
{% endblock %}
