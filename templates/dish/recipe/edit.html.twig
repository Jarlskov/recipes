{% extends 'base.html.twig' %}

{% block title %}Edit Recipe - {{ recipe.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/recipe-form.css') }}">
{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <nav class="breadcrumb">
            <a href="{{ path('dish_index') }}" class="breadcrumb-item">Dishes</a>
            <a href="{{ path('dish_show', {'id': dish.id}) }}" class="breadcrumb-item">{{ dish.name }}</a>
            <a href="{{ path('dish_recipe_show', {'id': dish.id, 'recipeId': recipe.id}) }}" class="breadcrumb-item">{{ recipe.name }}</a>
            <span class="breadcrumb-item active">Edit</span>
        </nav>
    </div>

    <div class="text-center mb-8">
        <h1 class="text-3xl font-bold mb-4">Edit Recipe</h1>
        <p class="text-gray-600">Update {{ recipe.name }}</p>
    </div>
    
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {% for message in app.flashes('error') %}
                    <div class="alert alert-error mb-4">
                        {{ message }}
                        <button type="button" class="alert-close">&times;</button>
                    </div>
                {% endfor %}

                <div class="form-group">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name) }}
                    {{ form_errors(form.name) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.steps) }}
                    <div id="steps-container" class="space-y-3" data-initial-count="{{ form.steps|length }}">
                        {% for step in form.steps %}
                            <div class="step-item flex items-start gap-2" draggable="true">
                                <div class="flex items-center gap-2">
                                    <div class="drag-handle cursor-move text-gray-400 hover:text-gray-600" title="Drag to reorder">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <line x1="3" y1="6" x2="21" y2="6"></line>
                                            <line x1="3" y1="12" x2="21" y2="12"></line>
                                            <line x1="3" y1="18" x2="21" y2="18"></line>
                                        </svg>
                                    </div>
                                    <div class="step-number w-6 h-6 bg-primary-color text-white rounded-full flex items-center justify-center text-sm font-semibold">
                                        {{ loop.index }}
                                    </div>
                                </div>
                                <div class="flex-1">
                                    {{ form_widget(step) }}
                                    {{ form_errors(step) }}
                                </div>
                                <button type="button" class="btn-icon btn-icon-danger remove-step" title="Remove step">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>
                                </button>
                            </div>
                        {% endfor %}
                    </div>
                    <button type="button" id="add-step" class="btn btn-outline btn-sm mt-2">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Add Step
                    </button>
                    {{ form_errors(form.steps) }}
                </div>

                    <div class="form-group">
                        {{ form_label(form.ingredients) }}
                        <div id="ingredients-container" class="space-y-3" 
                             data-initial-count="{{ form.ingredients|length }}"
                             data-prototype="{{ form_widget(form.ingredients.vars.prototype)|e('html_attr') }}">
                        {% for ingredient in form.ingredients %}
                            <div class="ingredient-item flex items-start gap-2" draggable="true">
                                <div class="flex items-center gap-2">
                                    <div class="drag-handle cursor-move text-gray-400 hover:text-gray-600" title="Drag to reorder">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <line x1="3" y1="6" x2="21" y2="6"></line>
                                            <line x1="3" y1="12" x2="21" y2="12"></line>
                                            <line x1="3" y1="18" x2="21" y2="18"></line>
                                        </svg>
                                    </div>
                                    <div class="ingredient-number w-6 h-6 bg-green-500 text-white rounded-full flex items-center justify-center text-sm font-semibold">
                                        {{ loop.index }}
                                    </div>
                                </div>
                                <div class="flex-1 grid grid-cols-3 gap-2">
                                    <div>
                                        {{ form_widget(ingredient.foodItemName) }}
                                        {{ form_errors(ingredient.foodItemName) }}
                                    </div>
                                    <div>
                                        {{ form_widget(ingredient.amount) }}
                                        {{ form_errors(ingredient.amount) }}
                                    </div>
                                    <div>
                                        {{ form_widget(ingredient.unit) }}
                                        {{ form_errors(ingredient.unit) }}
                                    </div>
                                </div>
                                <button type="button" class="btn-icon btn-icon-danger remove-ingredient" title="Remove ingredient">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>
                                </button>
                            </div>
                        {% endfor %}
                    </div>
                    <button type="button" id="add-ingredient" class="btn btn-outline btn-sm mt-2">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Add Ingredient
                    </button>
                    {{ form_errors(form.ingredients) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.rating) }}
                    {{ form_widget(form.rating) }}
                    {{ form_errors(form.rating) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.notes) }}
                    {{ form_widget(form.notes) }}
                    {{ form_errors(form.notes) }}
                </div>

                <div class="flex gap-3">
                    <button type="submit" class="btn btn-primary">Update Recipe</button>
                    <a href="{{ path('dish_recipe_show', {'id': dish.id, 'recipeId': recipe.id}) }}" class="btn btn-outline">Cancel</a>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/recipe-form.js') }}"></script>
{% endblock %}
