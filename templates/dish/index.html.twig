{% extends 'base.html.twig' %}

{% block title %}Dishes{% endblock %}

{% block body %}
<div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Dishes</h1>
    <a href="{{ path('dish_new') }}" class="btn btn-primary">+ New Dish</a>
</div>

{% if dishes is empty %}
    <div class="card p-6 text-center">
        <h2 class="text-xl font-semibold mb-4">No dishes yet</h2>
        <p class="text-gray-600 mb-4">Start by creating your first dish to organize your recipes.</p>
        <a href="{{ path('dish_new') }}" class="btn btn-primary">Create First Dish</a>
    </div>
{% else %}
    <div class="grid grid-3">
        {% for dish in dishes %}
            <div class="card dish-card" data-dish-id="{{ dish.id }}">
                <div class="card-body">
                    <!-- Action buttons in top-right -->
                    <div class="card-actions">
                        <a href="{{ path('dish_edit', {'id': dish.id}) }}" class="btn-icon" title="Edit dish">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                <path d="m18.5 2.5 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                            </svg>
                        </a>
                        <form method="post" action="{{ path('dish_delete', {'id': dish.id}) }}" class="btn-icon-form" onsubmit="return confirm('Are you sure you want to delete this dish?')">
                            <button type="submit" class="btn-icon btn-icon-danger" title="Delete dish">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3,6 5,6 21,6"></polyline>
                                    <path d="m19,6v14a2,2 0 0,1 -2,2H7a2,2 0 0,1 -2,-2V6m3,0V4a2,2 0 0,1 2,-2h4a2,2 0 0,1 2,2v2"></path>
                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                </svg>
                            </button>
                        </form>
                    </div>
                    
                    <!-- Tags at the top -->
                    <div class="card-tags">
                        {% if dish.dailyMealFriendly %}
                            <span class="badge badge-success">Daily Meal</span>
                        {% endif %}
                        {% if dish.prepFriendly %}
                            <span class="badge badge-info">Prep Friendly</span>
                        {% endif %}
                        {% if dish.freezerFriendly %}
                            <span class="badge badge-warning">Freezer Friendly</span>
                        {% endif %}
                    </div>
                    
                    <!-- Main content -->
                    <h3 class="card-title">{{ dish.name }}</h3>
                    <p class="card-text">{{ dish.description }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
