<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('css/main.css') }}">
        {% endblock %}

        {% block javascripts %}
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    // Simple alert dismissal
                    const alerts = document.querySelectorAll('.alert');
                    alerts.forEach(alert => {
                        const closeBtn = alert.querySelector('.alert-close');
                        if (closeBtn) {
                            closeBtn.addEventListener('click', () => {
                                alert.style.display = 'none';
                            });
                        }
                    });
                    
                    // Make dish cards clickable
                    const dishCards = document.querySelectorAll('.dish-card');
                    dishCards.forEach(card => {
                        card.addEventListener('click', function(e) {
                            // Don't navigate if clicking on action buttons
                            if (e.target.closest('.card-actions')) {
                                return;
                            }
                            
                            // Find the view link (we'll need to add this)
                            const dishId = card.dataset.dishId;
                            if (dishId) {
                                window.location.href = `/dish/${dishId}`;
                            }
                        });
                    });
                });
            </script>
        {% endblock %}
    </head>
    <body>
        <nav class="navbar">
            <div class="container">
                <div class="navbar-content">
                    {% if app.user %}
                        <a class="navbar-brand" href="{{ path('dish_index') }}">Recipe Manager</a>
                    {% else %}
                        <a class="navbar-brand" href="{{ path('home') }}">Recipe Manager</a>
                    {% endif %}
                    <div class="navbar-nav">
                        {% if app.user %}
                            <div class="nav-user">
                                <span class="text-gray-600">{{ app.user.firstName }}</span>
                                <a href="{{ path('logout') }}" class="nav-link">Logout</a>
                            </div>
                        {% else %}
                            <a class="nav-link" href="{{ path('login') }}">Login</a>
                            <a class="nav-link" href="{{ path('register') }}">Register</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>
        
        <main class="container mt-8">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    {{ message }}
                    <button type="button" class="alert-close">&times;</button>
                </div>
            {% endfor %}
            
            {% for message in app.flashes('error') %}
                <div class="alert alert-error">
                    {{ message }}
                    <button type="button" class="alert-close">&times;</button>
                </div>
            {% endfor %}
            
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
