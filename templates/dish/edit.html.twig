{% extends 'base.html.twig' %}

{% block title %}Edit {{ dish.name }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">Edit {{ dish.name }}</h1>
    
    <div class="card">
        <div class="card-body">
            <form method="post">
                <div class="form-group">
                    <label for="name" class="form-label">Name *</label>
                    <input type="text" class="form-control" id="name" name="name" value="{{ dish.name }}" required placeholder="Enter dish name">
                </div>
                
                <div class="form-group">
                    <label for="description" class="form-label">Description *</label>
                    <textarea class="form-control" id="description" name="description" rows="4" required placeholder="Describe this dish">{{ dish.description }}</textarea>
                </div>
                
                <div class="form-group">
                    <h3 class="text-lg font-semibold mb-4">Characteristics</h3>
                    
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="daily_meal_friendly" name="daily_meal_friendly" value="1" {{ dish.dailyMealFriendly ? 'checked' : '' }}>
                        <label class="form-check-label" for="daily_meal_friendly">
                            Daily Meal Friendly
                        </label>
                    </div>
                    
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="prep_friendly" name="prep_friendly" value="1" {{ dish.prepFriendly ? 'checked' : '' }}>
                        <label class="form-check-label" for="prep_friendly">
                            Prep Friendly
                        </label>
                    </div>
                    
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="freezer_friendly" name="freezer_friendly" value="1" {{ dish.freezerFriendly ? 'checked' : '' }}>
                        <label class="form-check-label" for="freezer_friendly">
                            Freezer Friendly
                        </label>
                    </div>
                </div>
                
                <div class="flex gap-4">
                    <button type="submit" class="btn btn-primary">Update Dish</button>
                    <a href="{{ path('dish_show', {'id': dish.id}) }}" class="btn btn-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
