{% extends 'base.html.twig' %}

{% block title %}Edit {{ dish.name }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">Edit {{ dish.name }}</h1>
    
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="form-group">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name) }}
                    {{ form_errors(form.name) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                </div>
                
                <div class="form-group">
                    <h3 class="text-lg font-semibold mb-4">Characteristics</h3>
                    
                    <div class="form-check">
                        {{ form_widget(form.dailyMealFriendly) }}
                        {{ form_label(form.dailyMealFriendly) }}
                    </div>
                    
                    <div class="form-check">
                        {{ form_widget(form.prepFriendly) }}
                        {{ form_label(form.prepFriendly) }}
                    </div>
                    
                    <div class="form-check">
                        {{ form_widget(form.freezerFriendly) }}
                        {{ form_label(form.freezerFriendly) }}
                    </div>
                </div>
                
                <div class="flex gap-4">
                    <button type="submit" class="btn btn-primary">Update Dish</button>
                    <a href="{{ path('dish_show', {'id': dish.id}) }}" class="btn btn-outline">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
